# Copy to .env for local development. Never commit the real .env file (gitignored).
# Deterministic tests require none of these. Integration tests require the ones they touch.

# Neon PostgreSQL + PostGIS connection string (shared infrastructure, see
# aidlc-docs/construction/shared-infrastructure.md)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Anthropic API key - used by Rule Research Assistant and Report Explanation
# (src/rule-research-assistant/, src/report-explanation/)
ANTHROPIC_API_KEY=sk-ant-placeholder

# MapTiler Cloud browser API key (Unit 2) - this is intentionally a PUBLIC, browser-visible key,
# not a server secret (a browser map necessarily exposes it). Restrict it via MapTiler's Allowed
# HTTP Origins to your deployed domain; do not treat this like DATABASE_URL/ANTHROPIC_API_KEY.
# NEXT_PUBLIC_ prefix is required for Next.js to expose it to client-side code.
NEXT_PUBLIC_MAPTILER_KEY=placeholder

# Unit 2B: Commercial Payment & Fulfillment

# Stripe secret key - test-mode (sk_test_...) for local/CI, live-mode (sk_live_...) only in
# production. Never mix a live key with a test-mode webhook secret or vice versa.
STRIPE_SECRET_KEY=sk_test_placeholder

# Stripe webhook signing secret for POST /api/webhooks/stripe (BR-U2B-4) - obtained from the
# Stripe dashboard/CLI for the specific webhook endpoint, distinct per environment.
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Resend API key - guest report-access email delivery (BR-U2B-10)
RESEND_API_KEY=re_placeholder
# EMAIL_FROM_ADDRESS=Permit Preflight <reports@permitpreflight.example>

# Shared secret Vercel's Cron infrastructure sends as `Authorization: Bearer <value>` when
# invoking GET /api/cron/reconcile - set this to the same value Vercel's Cron config uses.
CRON_SECRET=placeholder

# This deployment's own public base URL, used to build the guest report-access email link and
# Stripe's success/cancel URLs. Optional - falls back to Vercel's auto-injected VERCEL_URL if unset.
# APP_BASE_URL=https://permitpreflight.example

# Report price override (BR-U2B-12) - optional; defaults to 999 ($9.99) if unset. Must be a
# positive integer string of cents if set (fails closed on anything else - see
# src/checkout-fulfillment/types.ts).
# REPORT_PRICE_CENTS=999
# REPORT_CURRENCY=usd

# Unit 3: Minimum Paid-Product Operations

# Admin Basic Auth credentials, checked by proxy.ts before any /admin or /api/admin request
# reaches a page/route handler. Both required, or every admin route fails closed (401). Generate
# ADMIN_BASIC_AUTH_PASSWORD deliberately with a high-entropy generator - never a memorable phrase.
ADMIN_BASIC_AUTH_USERNAME=placeholder
ADMIN_BASIC_AUTH_PASSWORD=placeholder

# Attributes every admin mutation to a real operator identity in AdminActionLog - independent of
# the Basic Auth credential above (BR-U3-0a). Every mutating admin route fails closed if this is
# absent/blank, even if Basic Auth succeeded.
ADMIN_OPERATOR_ID=placeholder
