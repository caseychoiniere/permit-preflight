{
  "name": "permit-preflight",
  "version": "0.1.0",
  "private": true,
  "description": "Permit Preflight - Seattle residential buildability screening. Unit 2: Report Generation & Presentation Prototype.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
