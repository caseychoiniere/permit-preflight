# aidlc-reviewer reads this from the environment, not from a .env file loader (no dotenv
# dependency is used) - export it in your shell before launching Claude Code, or set it in
# whatever mechanism your shell/OS uses to persist environment variables. Copy this file to
# .env.example -> .env only as a personal reminder if you like; it is never read automatically.

OPENAI_API_KEY=sk-your-key-here
