{
  "name": "permit-preflight",
  "version": "0.1.0",
  "private": true,
  "description": "Permit Preflight - Seattle residential buildability screening. Unit 2: Report Generation & Presentation Prototype.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:enforce-vacant-land": "tsx scripts/enforce-vacant-land-migration.ts",
    "db:seed-staging-rules": "tsx scripts/seed-staging-rules.ts",
    "db:clear-staging-test-rules": "tsx scripts/clear-staging-test-rules.ts",
    "generate-prototype-report": "tsx scripts/generate-prototype-report.ts",
    "package:context": "bash scripts/package-chatgpt-context.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@sparticuz/chromium": "^131.0.1",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^4.7.1",
    "next": "^16.3.3",
    "playwright": "^1.48.0",
    "puppeteer-core": "^23.10.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^4.0.1",
    "stripe": "^17.4.0",
    "workflow": "^5.0.0-beta.33",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
